{
    "name": "architect/http-client",
    "description": "Full-featured HTTP client for Architect Framework with PSR-18 support, async requests, middleware, and multiple drivers.",
    "type": "architect-package",
    "license": "MIT",
    "keywords": [
        "http",
        "client",
        "psr-18",
        "psr-7",
        "async",
        "middleware",
        "architect",
        "framework"
    ],
    "homepage": "https://github.com/architect/http-client",
    "authors": [{
        "name": "Architect Team",
        "email": "team@architect.dev"
    }],
    "require": {
        "php": ">=8.1",
        "psr/http-message": "^1.1",
        "psr/http-client": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^1.1",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/http-client": "^6.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required for GuzzleDriver",
        "symfony/http-client": "Required for SymfonyDriver",
        "ext-curl": "Required for CurlDriver",
        "architect/framework": "Required for full integration"
    },
    "autoload": {
        "psr-4": {
            "Architect\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Architect\\HttpClient\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "architect": {
            "providers": [
                "Architect\\HttpClient\\Integration\\Architect\\HttpClientServiceProvider"
            ],
            "config": {
                "http-client": "config/http-client.php"
            }
        }
    }
}